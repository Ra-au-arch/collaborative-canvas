{
  "name": "collaborative-canvas",
  "version": "1.0.0",
  "description": "Real-Time Collaborative Drawing Canvas built with TypeScript, native HTML5 Canvas, Express, and Socket.IO",
  "main": "dist/server/server.js",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/build.mjs && node dist/server/server.js",
    "serve": "node dist/server/server.js",
    "test": "node --import tsx --test server/__tests__/drawing-state.test.ts server/__tests__/e2e-socket.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "canvas",
    "collaborative",
    "real-time",
    "socketio",
    "typescript",
    "html5-canvas"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.21.2",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "esbuild": "^0.23.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
